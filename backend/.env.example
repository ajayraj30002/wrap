# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://wrap:wrap@localhost:5432/wrap

# Encryption & Master Access (Must be at least 32 characters)
WRAP_MASTER_KEY=replace-with-at-least-32-random-characters

# Static Gateway API Keys (Optional, comma-separated)
WRAP_API_KEYS=wrap_optional_static_key_here

# Server Bind Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# DAG Autonomous Orchestration Limits
DAG_MAX_NODES=12
DAG_MAX_PARALLEL_NODES=6
